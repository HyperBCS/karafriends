{
  "name": "karafriends",
  "version": "0.1.0",
  "private": true,
  "main": "build/prod/main/index.js",
  "scripts": {
    "build-native-dev": "cargo-cp-artifact --npm cdylib native/index.node -- cargo build --message-format json-render-diagnostics --manifest-path native/Cargo.toml ${CARGO_ARGS:-}",
    "build-native-prod": "cargo-cp-artifact --npm cdylib native/index.node -- cargo build --message-format json-render-diagnostics --manifest-path native/Cargo.toml --release ${CARGO_ARGS:-}",
    "build-dev": "yarn get-external-resources && yarn build-native-dev && electron-vite build --mode development",
    "build-prod": "yarn get-external-resources && yarn build-native-prod && electron-vite build",
    "dev": "yarn get-external-resources && yarn build-native-dev && electron-vite dev -w --entry build/dev/main/index.js",
    "run-dev": "yarn dev",
    "package-prod": "node ./packager.js",
    "get-external-resources": "node scripts/getExternalResources.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "lint": "oxlint --deny-warnings",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:native": "cargo clippy --manifest-path native/Cargo.toml && cargo +nightly careful test --manifest-path native/Cargo.toml",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:e2e:ci": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --grep-invert \"@net|@jp\"",
    "postinstall": "husky && install-electron"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "@types/youtube-player": "5.5.11",
    "classnames": "2.5.1",
    "color-convert": "3.1.3",
    "compression": "1.8.1",
    "cubic-spline": "3.0.3",
    "electron-is-dev": "3.0.1",
    "express": "5.2.1",
    "fft.js": "4.0.4",
    "format-duration": "4.0.0",
    "gl-vec2": "1.3.0",
    "hls.js": "1.7.1",
    "kuroshiro": "1.2.0",
    "kuroshiro-analyzer-kuromoji": "1.1.0",
    "lodash": "4.18.1",
    "materialize-css": "1.0.0",
    "multicast-dns": "7.2.5",
    "node-fetch": "3.3.2",
    "polyline-normals": "2.0.2",
    "promise-retry": "2.0.1",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-fade-in": "2.0.1",
    "react-icons": "5.7.0",
    "react-mobile-picker-scroll": "0.2.14",
    "react-router": "8.3.0",
    "ts-invariant": "0.10.3",
    "tunnel": "0.0.6",
    "uuid": "14.0.2",
    "wanakana": "5.3.1",
    "yaml": "2.9.0",
    "youtube-player": "5.6.0",
    "youtubei.js": "patch:youtubei.js@npm%3A18.0.0#~/.yarn/patches/youtubei.js-npm-18.0.0-0d3f1af340.patch"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/gl-vec2": "1.3.5",
    "@types/lodash": "4.17.25",
    "@types/materialize-css": "1.0.15",
    "@types/node": "26.4.0",
    "@types/promise-retry": "1.1.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/tunnel": "^0",
    "@vitejs/plugin-react": "6.1.2",
    "cargo-cp-artifact": "0.1.9",
    "electron": "43.4.1",
    "electron-vite": "6.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "oxlint": "1.90.0",
    "prettier": "3.9.6",
    "sass": "1.106.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "packageManager": "yarn@4.18.1"
}
