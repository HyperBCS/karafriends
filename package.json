{
  "name": "karafriends",
  "version": "0.1.0",
  "private": true,
  "main": "build/prod/main_/index.js",
  "scripts": {
    "build-native-dev": "cargo-cp-artifact --npm cdylib native/index.node -- cross-env-shell \"cargo build --message-format json-render-diagnostics --manifest-path native/Cargo.toml ${CARGO_ARGS:-}\"",
    "build-native-prod": "cargo-cp-artifact --npm cdylib native/index.node -- cross-env-shell \"cargo build --message-format json-render-diagnostics --manifest-path native/Cargo.toml --release ${CARGO_ARGS:-}\"",
    "build-relay-dev": "relay-compiler",
    "build-relay-prod": "relay-compiler",
    "build-parcel-dev": "parcel build --dist-dir build/dev --public-url . --no-optimize",
    "build-parcel-prod": "parcel build --dist-dir build/prod --public-url . --no-source-maps",
    "build-dev": "concurrently \"yarn get-external-resources && yarn build-native-dev\" \"yarn build-relay-dev\" && yarn build-parcel-dev",
    "build-prod": "concurrently \"yarn get-external-resources && yarn build-native-prod\" \"yarn build-relay-prod\" && yarn build-parcel-prod",
    "run-dev": "cross-env NODE_ENV=development yarn _run-dev",
    "_run-dev": "yarn build-dev && concurrently --success !command-0 --kill-others \"parcel serve --target remocon --target renderer --dist-dir build/dev --port 3000\" \"wait-on http://127.0.0.1:3000/ && cross-env NODE_OPTIONS=--enable-source-maps electron build/dev/main_/index.js\"",
    "package-prod": "node ./packager.js",
    "get-external-resources": "node scripts/getExternalResources.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test:unit": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:native": "cargo clippy --manifest-path native/Cargo.toml && cargo +nightly careful test --manifest-path native/Cargo.toml",
    "postinstall": "husky && install-electron"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@graphql-tools/schema": "10.1.0",
    "@types/youtube-player": "5.5.11",
    "bufferutil": "4.1.0",
    "classnames": "2.5.1",
    "color-convert": "3.1.3",
    "compression": "1.8.1",
    "cubic-spline": "3.0.3",
    "electron-is-dev": "3.0.1",
    "express": "5.2.1",
    "fft.js": "4.0.4",
    "format-duration": "4.0.0",
    "gl-vec2": "1.3.0",
    "graphql": "17.0.2",
    "graphql-subscriptions": "3.0.0",
    "graphql-ws": "6.2.1",
    "hls.js": "1.7.1",
    "kuroshiro": "1.2.0",
    "kuroshiro-analyzer-kuromoji": "1.1.0",
    "lodash": "4.18.1",
    "materialize-css": "1.0.0",
    "multicast-dns": "7.2.5",
    "node-fetch": "3.3.2",
    "parcel-reporter-static-files-copy": "1.5.3",
    "polyline-normals": "2.0.2",
    "process": "0.11.10",
    "promise-retry": "2.0.1",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-fade-in": "2.0.1",
    "react-icons": "5.7.0",
    "react-mobile-picker-scroll": "0.2.14",
    "react-relay": "21.0.1",
    "react-router": "8.3.0",
    "regenerator-runtime": "0.14.1",
    "relay-runtime": "21.0.1",
    "supports-color": "11.0.0",
    "ts-invariant": "0.10.3",
    "tunnel": "0.0.6",
    "utf-8-validate": "6.0.6",
    "uuid": "14.0.2",
    "wanakana": "5.3.1",
    "ws": "8.21.3",
    "yaml": "2.9.0",
    "youtube-player": "5.6.0",
    "youtubei.js": "patch:youtubei.js@npm%3A18.0.0#~/.yarn/patches/youtubei.js-npm-18.0.0-0d3f1af340.patch"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@babel/core": "7.29.7",
    "@electron/packager": "20.3.0",
    "@parcel/config-default": "2.16.4",
    "@parcel/core": "2.16.4",
    "@parcel/transformer-glsl": "2.16.4",
    "@parcel/transformer-inline-string": "2.16.4",
    "@parcel/transformer-sass": "2.16.4",
    "@parcel/transformer-worklet": "2.16.4",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/gl-vec2": "1.3.5",
    "@types/lodash": "4.17.25",
    "@types/materialize-css": "1.0.15",
    "@types/node": "26.4.0",
    "@types/promise-retry": "1.1.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/tunnel": "^0",
    "@types/ws": "^8",
    "babel-plugin-relay": "21.0.1",
    "buffer": "^5.5.0||^6.0.0",
    "cargo-cp-artifact": "0.1.9",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "oxlint": "1.90.0",
    "parcel": "2.16.4",
    "path-browserify": "^1.0.0",
    "prettier": "3.9.6",
    "relay-compiler": "21.0.1",
    "typescript": "6.0.3",
    "wait-on": "9.1.0"
  },
  "packageManager": "yarn@4.18.1",
  "targets": {
    "main_": {
      "source": "src/main/index.ts",
      "context": "electron-main",
      "includeNodeModules": true
    },
    "preload": {
      "source": "src/preload/index.ts",
      "context": "electron-renderer",
      "includeNodeModules": true,
      "scopeHoist": true
    },
    "renderer": {
      "source": "src/renderer/index.html",
      "context": "browser"
    },
    "remocon": {
      "source": "src/remocon/index.html",
      "context": "browser"
    }
  },
  "@parcel/bundler-default": {
    "minBundles": 100
  },
  "relay": {
    "src": "src",
    "schema": "src/common/schema.graphql",
    "language": "typescript"
  },
  "alias": {
    "@parcel/error-overlay": "./src/common/disableParcelErrorOverlay.ts"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
